#!/usr/bin/env bash
set -eo pipefail

tool_name="docker-compose"
install_type="$ASDF_INSTALL_TYPE"
version="$ASDF_INSTALL_VERSION"
install_path="$ASDF_INSTALL_PATH"
download_path="$ASDF_DOWNLOAD_PATH"

if [ "$install_type" != "version" ]; then
  echo "asdf-$tool_name supports data-type 'version' only (got: $install_type)"
  exit 1
fi

(
  mkdir -p "$install_path/bin"

  # Navigate to download folder where the download script saved the file
  cd "$download_path"

  echo "Installing $tool_name v$version..."

  # docker-compose releases ship a single raw binary named
  # `docker-compose-{platform}-{arch}` (no archive extension). Move it into the
  # install bin directory and rename it to the canonical `docker-compose` name.
  binary=$(find . -maxdepth 1 -type f -name "${tool_name}-*-*" | head -n 1)
  if [ -z "$binary" ]; then
    echo "Error: No ${tool_name} binary found in ${download_path}"
    exit 1
  fi

  cp "$binary" "$install_path/bin/${tool_name}"
  chmod +x "$install_path/bin/${tool_name}"

  echo "$tool_name v$version installation was successful!"
) || {
  echo "Error: Installation failed."
  exit 1
}
